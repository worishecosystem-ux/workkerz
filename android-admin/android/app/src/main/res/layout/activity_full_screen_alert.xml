<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_alert_card"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WORKKERZ"
                android:textColor="#111827"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"/>

            <TextView
                android:id="@+id/alert_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="NEW ALERT"
                android:textColor="#087F3E"
                android:textSize="10sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/alert_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="#111827"
                android:textSize="23sp"
                android:textStyle="bold"
                android:maxLines="2"/>

            <TextView
                android:id="@+id/detail_customer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:textColor="#111827"
                android:textSize="20sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/alert_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="#6B7280"
                android:textSize="11sp"
                android:maxLines="2"/>

            <TextView
                android:id="@+id/detail_worker"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/detail_service"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/detail_duration"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/detail_date"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/detail_time"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/detail_location"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/detail_amount"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/detail_booking_id"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/detail_order_id"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/detail_worker_request_id"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/detail_status"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/alert_timer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:textColor="#E53935"
                android:textSize="11sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/btn_reject"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Reject"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:backgroundTint="#E53935"/>

            <Button
                android:id="@+id/btn_accept"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Accept"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:backgroundTint="#08A957"/>
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
