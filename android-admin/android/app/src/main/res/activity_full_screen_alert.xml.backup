<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#171717">

    <!-- Background -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_alert_background"/>

    <ScrollView
        android:id="@+id/content_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingTop="22dp"
        android:paddingBottom="180dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Workkerz"
                        android:textColor="#FFFFFF"
                        android:textSize="30sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kaam Sabke Liye"
                        android:textColor="#E5E7EB"
                        android:textSize="13sp"
                        android:layout_marginTop="-3dp"
                        android:layout_gravity="center"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/alert_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="18dp"
                    android:paddingTop="9dp"
                    android:paddingEnd="18dp"
                    android:paddingBottom="9dp"
                    android:text="●  Partner App\n    Online"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_online"/>

            </LinearLayout>

            <!-- HERO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="18dp">

                <TextView
                    android:layout_width="92dp"
                    android:layout_height="92dp"
                    android:gravity="center"
                    android:text="▣"
                    android:textColor="#FFD34E"
                    android:textSize="48sp"
                    android:background="@drawable/bg_hero_icon"/>

                <TextView
                    android:id="@+id/alert_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="New Work Booking!"
                    android:textColor="#FFFFFF"
                    android:textSize="31sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/alert_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:text="A customer needs your service"
                    android:textColor="#D1D5DB"
                    android:textSize="17sp"/>

            </LinearLayout>


            <!-- MAIN CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="vertical"
                android:padding="20dp"
                android:background="@drawable/bg_main_card">

                <!-- CUSTOMER -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/customer_initial"
                        android:layout_width="68dp"
                        android:layout_height="68dp"
                        android:gravity="center"
                        android:text="R"
                        android:textColor="#1261A0"
                        android:textSize="31sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_customer_avatar"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="16dp">

                        <TextView
                            android:id="@+id/detail_customer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Rahul Sharma"
                            android:textColor="#111827"
                            android:textSize="21sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/customer_rating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="★  4.8   (12 bookings)"
                            android:textColor="#4B5563"
                            android:textSize="14sp"/>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:gravity="center"
                            android:text="☎"
                            android:textColor="#102A43"
                            android:textSize="25sp"
                            android:background="@drawable/bg_circle_button"/>

                        <TextView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="8dp"
                            android:gravity="center"
                            android:text="▤"
                            android:textColor="#102A43"
                            android:textSize="25sp"
                            android:background="@drawable/bg_circle_button"/>

                    </LinearLayout>

                </LinearLayout>


                <!-- SERVICE -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:padding="14dp"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_service">

                    <TextView
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:gravity="center"
                        android:text="⚡"
                        android:textSize="30sp"
                        android:background="@drawable/bg_service_icon"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="14dp">

                        <TextView
                            android:id="@+id/detail_worker"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Electrician"
                            android:textColor="#111827"
                            android:textSize="20sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/service_description"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Wiring &amp; Installation"
                            android:textColor="#6B7280"
                            android:textSize="14sp"/>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="end">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="▣  Today"
                            android:textColor="#087F5B"
                            android:textSize="13sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/detail_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="2:00 PM - 4:00 PM"
                            android:textColor="#111827"
                            android:textSize="15sp"
                            android:textStyle="bold"/>

                    </LinearLayout>

                </LinearLayout>


                <!-- LOCATION -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="55dp"
                        android:layout_height="55dp"
                        android:gravity="center"
                        android:text="●"
                        android:textColor="#D62828"
                        android:textSize="28sp"
                        android:background="@drawable/bg_location_icon"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="13dp"
                        android:paddingEnd="8dp">

                        <TextView
                            android:id="@+id/location_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Arera Colony, Bhopal"
                            android:textColor="#111827"
                            android:textSize="17sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/detail_location"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Plot 12, Near Chetak Bridge, Arera Colony, Bhopal - 462016"
                            android:textColor="#6B7280"
                            android:textSize="13sp"/>

                    </LinearLayout>

                    <TextView
                        android:layout_width="105dp"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:text="▱  View on Map"
                        android:textColor="#102A43"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_map_button"/>

                </LinearLayout>


                <!-- DIVIDER -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="17dp"
                    android:background="#E5E7EB"/>


                <!-- CUSTOMER NOTE -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:gravity="top">

                    <TextView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:gravity="center"
                        android:text="▤"
                        android:textColor="#172033"
                        android:textSize="24sp"
                        android:background="@drawable/bg_note_icon"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Customer Note"
                            android:textColor="#111827"
                            android:textSize="16sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/customer_note"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Need help with this work. Please bring basic tools."
                            android:textColor="#374151"
                            android:textSize="13sp"/>

                    </LinearLayout>

                </LinearLayout>


                <!-- PAY + DURATION -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    android:paddingTop="14dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:gravity="center"
                        android:text="₹"
                        android:textColor="#172033"
                        android:textSize="23sp"
                        android:background="@drawable/bg_note_icon"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Estimated Pay"
                            android:textColor="#6B7280"
                            android:textSize="13sp"/>

                        <TextView
                            android:id="@+id/detail_amount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="₹500 - ₹700"
                            android:textColor="#07883F"
                            android:textSize="20sp"
                            android:textStyle="bold"/>

                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="45dp"
                        android:background="#E5E7EB"/>

                    <TextView
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="18dp"
                        android:gravity="center"
                        android:text="◷"
                        android:textColor="#172033"
                        android:textSize="25sp"
                        android:background="@drawable/bg_note_icon"/>

                    <LinearLayout
                        android:layout_width="105dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Expected Duration"
                            android:textColor="#6B7280"
                            android:textSize="12sp"/>

                        <TextView
                            android:id="@+id/detail_duration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="2 hours"
                            android:textColor="#111827"
                            android:textSize="17sp"
                            android:textStyle="bold"/>

                    </LinearLayout>

                </LinearLayout>

                <!-- Existing hidden/status values used by Java -->
                <TextView
                    android:id="@+id/detail_status"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/detail_date"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/detail_worker_request_id"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone"/>

            </LinearLayout>


            <!-- AUTO REJECT -->
            <LinearLayout
                android:id="@+id/auto_reject_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:padding="15dp"
                android:gravity="center"
                android:orientation="vertical"
                android:background="@drawable/bg_auto_reject">

                <TextView
                    android:id="@+id/alert_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="◷   Auto reject in 00:45"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Accept soon to confirm this booking"
                    android:textColor="#D1D5DB"
                    android:textSize="13sp"/>

            </LinearLayout>

        </LinearLayout>

    </ScrollView>


    <!-- BOTTOM ACTIONS -->
    <LinearLayout
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingBottom="18dp"
        android:paddingTop="12dp"
        android:background="@drawable/bg_bottom_actions"
        android:elevation="20dp"
        android:layout_gravity="bottom">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_reject"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginEnd="7dp"
                android:text="✕  Reject"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:background="@drawable/bg_reject_button"/>

            <Button
                android:id="@+id/btn_accept"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                android:text="✓  Accept"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold"
                android:background="@drawable/bg_accept_button"/>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="— —    More Work. A Better Tomorrow.    — —"
            android:textColor="#D1D5DB"
            android:textSize="12sp"/>

    
        <TextView
            android:id="@+id/detail_order_id"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"/>
</LinearLayout>


<TextView
    android:id="@+id/detail_service"
    android:layout_width="1dp"
    android:layout_height="1dp"
    android:visibility="gone" />

<TextView
    android:id="@+id/detail_booking_id"
    android:layout_width="1dp"
    android:layout_height="1dp"
    android:visibility="gone" />

</FrameLayout>
